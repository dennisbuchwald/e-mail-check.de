# Shared site config for local (Caddyfile) and production (Caddyfile.prod).
(site) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy engine:8787 {
			# SSE: pass events through immediately.
			flush_interval -1
		}
	}

	# Statistics (only when the "stats" profile runs). Same origin: no third party, no CSP exception.
	# Only the tracking script and its endpoint are public; the Umami login stays unreachable from outside (audit I6).
	@stats path /stats/script.js /stats/api/send
	handle @stats {
		uri strip_prefix /stats
		reverse_proxy umami:3000
	}
	handle /stats/* {
		respond 404
	}

	# Shared results: the static shell plus the server-rendered result (engine /api/results/<id>/view),
	# included via templates so it is visible without JavaScript. Custom delimiters: nothing else in the page is parsed.
	@result path_regexp result ^/ergebnis/([A-Za-z0-9_-]{22})$
	handle @result {
		root * /srv
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-store"
		rewrite * /ergebnis.html
		templates {
			mime text/html
			between "<!--emc{" "}emc-->"
		}
		file_server
	}

	handle {
		root * /srv
		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@static path *.png *.ico *.webmanifest /favicon.svg
		header @static Cache-Control "public, max-age=86400"
		@pages not path /_astro/* *.png *.ico *.webmanifest /favicon.svg
		header @pages Cache-Control "public, max-age=300"
		# Clean URLs: /spf-check → spf-check.html, trailing slash → without.
		@slash path_regexp slash ^(.+)/$
		redir @slash {re.slash.1} 301
		try_files {path} {path}.html
		file_server {
			precompressed br gzip
		}
	}

	handle_errors {
		root * /srv
		rewrite * /404.html
		file_server
	}
}
