# Production. Values come from .env (see .env.example).
{
	admin off
	# No IP addresses or browser IDs in the logs (privacy policy): Caddy's handler warnings, e.g. on a 502
	# during an engine restart, would otherwise contain the full request (audit, 21.10.2026).
	log {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
			}
		}
	}
	# Fixed issuer so the certificate path for the MX hostname is predictable (certsync copies it).
	cert_issuer acme https://acme-v02.api.letsencrypt.org/directory
}

import /etc/caddy/site.caddy

{$SITE_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	import site
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} 301
}

# Only here so Caddy fetches a certificate for STARTTLS on the mail intake.
{$MX_HOSTNAME} {
	respond "e-mail-check.de Testempfang" 200
}
