---
// Brand mark from brand/logo-mark.svg: envelope with flap cut out, green check circle separated by a gap.
interface Props {
	size?: number;
	withText?: boolean;
}
const { size = 38, withText = true } = Astro.props;
---

<span class="logo">
	<svg width={size} height={size} viewBox="0 0 120 120" aria-hidden="true">
		<defs>
			<mask id="logo-m" maskUnits="userSpaceOnUse" x="0" y="0" width="120" height="120">
				<rect width="120" height="120" fill="#fff"></rect>
				<path d="M26 60 L51 78 L76 60" fill="none" stroke="#000" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"></path>
				<circle cx="96" cy="36" r="25" fill="#000"></circle>
			</mask>
		</defs>
		<rect x="8" y="40" width="86" height="62" rx="13" fill="#1D1D1F" mask="url(#logo-m)"></rect>
		<circle cx="96" cy="36" r="18" fill="#02CA50"></circle>
		<path d="M88.5 36.5 L94 42 L103.5 31.5" fill="none" stroke="#1D1D1F" stroke-width="5.8" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
	{withText && <span class="h logo-text" aria-hidden="true">e-mail-check<span class="tld">.de</span></span>}
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}
	.logo-text {
		font-size: 18px;
		letter-spacing: -0.2px;
		line-height: 1;
	}
	.tld {
		color: var(--domain-gray);
	}
	@media (max-width: 820px) {
		.logo-text {
			font-size: 16px;
		}
	}
</style>
