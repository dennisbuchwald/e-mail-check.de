---
// The mail test: hero/start → check animation → result → guide. Logic in src/scripts/tool.ts.
// Designs: design/redesign/hero-animation-prototyp.html (hero), ergebnis-final. mode "result" renders /ergebnis/<id>.
import { STEP_LABELS, STEPS } from '@emc/shared';
import { PROVIDERS, SITE } from '../data/site';

interface Props {
	mode?: 'test' | 'result';
	title?: string;
	intro?: string;
}
const { mode = 'test', title = 'Kommt deine Mail an?', intro = '' } = Astro.props;
const details: Record<string, string> = {
	received: 'Warte auf den Eingang deiner Mail …',
	spf: 'Suche den SPF-Eintrag deiner Domain …',
	dkim: 'Prüfe die DKIM-Unterschrift …',
	dmarc: 'Lese deine DMARC-Regel …',
	reputation: 'Frage Sperrlisten und rDNS ab …',
	content: 'Analysiere Betreff, Links und Inhalt …',
};
const copyIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>';
---

<section class="tool" id="tool" data-mode={mode} data-setup-url={SITE.setupUrl} aria-live="polite">
	<div class="dots" aria-hidden="true"></div>

	<!-- START -->
	<div class="screen hero" data-screen="start" hidden={mode === 'result'}>
		<div class="hero-copy">
			<h1>{title}</h1>
			{intro && <p class="lead">{intro}</p>}
		</div>
		<div class="mw-wrap">
		<div class="glow" aria-hidden="true"><i class="g-base"></i><i class="g-res"></i></div>
		<div class="card mailwin">
			<div class="mw-head"><span class="mw-title">Neue Nachricht</span><span class="mono mw-tag">Testmail</span></div>
			<div class="mw-row">
				<span class="mw-label">An</span>
				<span class="address" data-address aria-live="off"><span class="address-loading">Adresse wird erstellt …</span></span>
				<button type="button" class="btn btn-line mw-copy copy-address" data-action="copy" disabled><span>Kopieren</span></button>
			</div>
			<div class="mw-foot">
				<span class="status-line"><span class="live"></span><span data-start-hint>Wir warten auf deine Mail.</span></span>
				<span class="panel-actions">
					<a class="btn btn-line mw-mailto" data-mailto href="#" aria-disabled="true"><span>Mail-Programm öffnen</span></a>
					<button type="button" class="btn btn-ink" data-action="sent" disabled
						>Mail ist raus<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button
					>
				</span>
			</div>
		</div>
		</div>
		<ul class="trust" aria-label="Datenschutz">
			<li><span class="chk" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg></span>Server in Deutschland</li>
			<li><span class="chk" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg></span>Testmail sofort gelöscht</li>
			<li><span class="chk" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg></span>Keine Cookies, kein Konto</li>
		</ul>
		<a class="scroll-hint" href="#so-funktionierts"
			>So funktioniert's<svg class="nudge" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></a
		>
	</div>

	<!-- WAIT / CHECK -->
	<div class="screen wait" data-screen="wait" hidden>
		<div class="glow" aria-hidden="true" data-glow><i class="g-base"></i><i class="g-res"></i></div>
		<div class="wait-visual">
			<div class="orb" data-orb>
				<div class="prog" data-prog></div>
				<div class="prog-mask"></div>
				<div class="radar" aria-hidden="true"></div>
				<div class="ring2"></div>
				<div class="sat" data-sat><span></span></div>
				<div class="lamps" aria-hidden="true">{STEPS.slice(1).map((id, i) => <span class="lamp" data-lamp={id} style={`--a: ${i * 72}deg`} />)}</div>
				<div class="fly" data-fly aria-hidden="true" hidden
					><span class="fly-y"
						><svg width="34" height="34" viewBox="0 0 24 24" fill="#fff" stroke="#111113" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span
					></div
				>
				<div class="burst" data-burst hidden>{Array.from({ length: 12 }, (_, i) => <i style={`--a: ${i * 30}deg`} />)}</div>
				<div class="core">
					<div class="scan" data-scan hidden></div>
					<svg class="env" data-env-wait width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
						><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg
					>
					<svg class="env pop" data-env-got hidden width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
						><path d="M21 12V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h8"></path><path d="M3 7l9 6 9-6"></path><path d="M16 19l2 2 4-4"></path></svg
					>
				</div>
			</div>
			<div class="wait-text">
				<h2 class="wait-title" data-wait-title tabindex="-1">Wir warten auf deine Mail</h2>
				<p class="wait-sub"><span class="typing" aria-hidden="true"><span></span><span></span><span></span></span><span data-wait-sub>Die Seite aktualisiert sich von selbst</span></p>
				<div class="wait-slot">
					<div class="wait-before" data-wait-before>
						<p class="wait-clock mono" data-wait-clock></p>
						<p class="wait-addr">An <span class="mono" data-address-small></span> <button type="button" class="linkbtn" data-action="copy">kopieren</button><br /><a class="linkbtn nowrap" data-mailto href="#">Mail-Programm öffnen</a></p>
						<p class="wait-hint" data-wait-hint aria-live="off"></p>
					</div>
					<div class="wait-after" data-wait-after>
						<div class="wait-mail" data-wait-mail>
							<span class="wm-row"><span class="eyebrow">Von</span><span class="mono" data-wm-from></span></span>
							<span class="wm-row" data-wm-subject-row><span class="eyebrow">Betreff</span><span data-wm-subject></span></span>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="card steps-card">
			<span class="eyebrow">Prüfung</span>
			<ol class="steps" data-steps>
				{
					STEPS.map((id) => (
						<li class="step" data-step={id} data-state="pending">
							<span class="st" aria-hidden="true">
								<svg class="ic-ok" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M5 12l4 4 10-10" />
								</svg>
								<svg class="ic-alert" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round">
									<path d="M12 5v9M12 19h.01" />
								</svg>
							</span>
							<span class="step-text">
								<span class="step-label">{STEP_LABELS[id]}</span>
								<span class="step-detail mono">{details[id]}</span>
							</span>
						</li>
					))
				}
			</ol>
		</div>
	</div>

	<!-- RESULT -->
	<div class="screen result wrap" data-screen="result" hidden>
		<div class="card mailhead">
			<span class="mh-item"><span class="eyebrow">Absender</span><span class="mono" data-mh-from>–</span></span>
			<span class="mh-item" data-mh-row><span class="eyebrow">Betreff</span><span data-mh-subject>–</span></span>
			<span class="mh-item"><span class="eyebrow">Empfangen</span><span class="mono" data-mh-time>–</span></span>
			<span class="mh-spacer"></span>
			<button type="button" class="linkbtn mh-new" data-action="reset" data-new-test>‹ Neuer Test</button>
		</div>
		<div class="result-grid">
			<div class="result-main">
				<h1 class="verdict" data-headline tabindex="-1">Dein Ergebnis</h1>
				<div class="card scorecard">
					<div class="score-block">
						<span class="eyebrow">Score</span>
						<span class="score-line"><span class="h score-num" data-score>–</span><span class="score-of"> / 10</span></span>
						<span class="tag with-dot" data-band>–</span>
					</div>
					<div class="subs" data-subs></div>
				</div>
				<div class="auth-warning card" data-auth-warning hidden>
					<span class="tag is-warn">Ausnahme</span>
					<span>SPF, DKIM oder DMARC schlägt fehl. Darum warnen wir, egal wie hoch die Zahl ist: Das allein kann Mails in den Spam schicken.</span>
				</div>
				<div class="plan-head" data-plan-head>
					<span class="eyebrow">Aktionsplan</span>
					<h2 class="plan-title">Der Reihe nach beheben. Größte Wirkung zuerst.</h2>
				</div>
				<ol class="plan" data-plan></ol>
				<div class="card passed" data-passed-wrap>
					<div class="passed-head" data-passed-head></div>
					<ul class="passed-list" data-passed></ul>
				</div>
			</div>
			<aside class="result-side">
				<div class="card side-card">
					<span class="eyebrow">Was das für dich bedeutet</span>
					<p class="side-text" data-sub></p>
				</div>
				<div class="card side-card">
					<span class="eyebrow">Für deinen Kunden</span>
					<div class="copyrow">
						<span class="mono" data-share-url>–</span>
						<button type="button" class="copybtn" data-action="share" aria-label="Ergebnis-Link kopieren"><Fragment set:html={copyIcon} /><span>Kopieren</span></button>
					</div>
					<span class="side-note" data-share-note>7 Tage gültig · nicht in Google auffindbar</span>
				</div>
				<button type="button" class="btn btn-ink retest" data-action="reset">Nach dem Beheben erneut testen</button>
				<details class="card side-card tech">
					<summary><span>Technische Details</span><span class="mono tech-hint">Header · DNS · Rohdaten ›</span></summary>
					<div class="tech-body" data-tech></div>
				</details>
				<p class="setup" data-setup hidden>Keine Zeit? <a href={SITE.setupUrl} rel="noopener">Lass es einrichten</a></p>
			</aside>
		</div>
	</div>

	<!-- GUIDE -->
	<div class="screen guide wrap" data-screen="guide" hidden>
		<button type="button" class="linkbtn back" data-action="back">‹ Zurück zum Ergebnis</button>
		<div class="guide-grid">
			<div class="guide-intro">
				<span class="eyebrow">Anleitung</span>
				<h2 class="guide-title" data-guide-title tabindex="-1">Schutzregel einrichten</h2>
				<p class="lead" data-guide-lead></p>
				<div class="guide-pick">
					<div class="eyebrow" id="provider-label">Wo liegt deine Domain?</div>
					<div class="chips" role="group" aria-labelledby="provider-label" data-providers>
						{PROVIDERS.map((p) => <button type="button" class="chip" data-provider={p.slug} aria-pressed="false">{p.name}</button>)}
						<button type="button" class="chip" data-provider="andere" aria-pressed="false">Anderer Anbieter</button>
					</div>
				</div>
			</div>
			<div class="card guide-card">
				<ol class="guide-steps" data-guide-steps></ol>
				<p class="guide-note">Neue Einträge brauchen manchmal ein paar Minuten, bis sie überall sichtbar sind.</p>
				<div class="guide-actions">
					<button type="button" class="btn btn-ink" data-action="retest">Erneut testen</button>
					<a class="btn btn-line" data-guide-link href="/anleitung">Ausführliche Anleitung</a>
				</div>
			</div>
		</div>
	</div>

	<!-- MESSAGE (expired, error, not found) -->
	<div class="screen msg wrap" data-screen="msg" hidden>
		<div class="card msg-card">
			<h1 class="msg-title" data-msg-title tabindex="-1">Diese Adresse ist abgelaufen</h1>
			<p class="lead" data-msg-text>Testadressen gelten 60 Minuten. Hol dir einfach eine neue.</p>
			<button type="button" class="btn btn-ink" data-action="reset">Neue Testadresse</button>
		</div>
	</div>
	<div class="sr-only" data-announce aria-live="assertive"></div>
</section>

<script>
	import { initTool } from '../scripts/tool';
	initTool();
</script>

<style>
	.tool {
		position: relative;
		background: #fff;
		overflow: hidden;
	}
	:global(body[data-tool-state='result']) .tool,
	:global(body[data-tool-state='guide']) .tool,
	:global(body[data-tool-state='msg']) .tool {
		background: var(--bg-soft);
		padding: 40px 0 72px;
	}
	:global(body[data-tool-state='result']) .dots,
	:global(body[data-tool-state='guide']) .dots,
	:global(body[data-tool-state='msg']) .dots {
		display: none;
	}
	.screen[hidden] {
		display: none !important;
	}

	/* Dot grid, fading out from the centre (design/redesign/hero-animation-prototyp.html). */
	.dots {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image: radial-gradient(#cfcfd6 1px, transparent 1.2px);
		background-size: 22px 22px;
		-webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 42%, #000 20%, transparent 75%);
		mask-image: radial-gradient(ellipse 60% 55% at 50% 42%, #000 20%, transparent 75%);
	}

	/* One soft green glow behind the mail window (V2 addendum). Breathes while checking,
	   takes the result colour at the end, then fades out. Only transform/opacity move. */
	.mw-wrap {
		position: relative;
		width: 100%;
		max-width: 760px;
	}
	.mw-wrap .mailwin {
		position: relative;
		z-index: 1;
	}
	.glow {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 760px;
		height: 300px;
		pointer-events: none;
		transform: translate(-50%, -38%);
	}
	.glow i {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		filter: blur(30px);
		transition: opacity 0.3s ease;
	}
	.g-base {
		background: radial-gradient(closest-side, rgba(2, 202, 80, 0.14), rgba(2, 202, 80, 0));
	}
	.g-res {
		opacity: 0;
		background: radial-gradient(closest-side, var(--glow-c, rgba(2, 202, 80, 0.14)), rgba(255, 255, 255, 0));
	}
	.wait .glow {
		transform: translate(-50%, -50%);
	}
	.wait > :not(.glow) {
		position: relative;
		z-index: 1;
	}
	:global(body[data-tool-state='wait']) .wait .glow:not(.fade) {
		animation: glow-breathe 2.4s ease-in-out infinite alternate;
	}
	.glow[data-result='ok'] {
		--glow-c: rgba(2, 202, 80, 0.14);
	}
	.glow[data-result='warn'] {
		--glow-c: rgba(255, 138, 0, 0.14);
	}
	.glow[data-result='bad'] {
		--glow-c: rgba(255, 64, 52, 0.14);
	}
	.glow[data-result] .g-res {
		opacity: 1;
	}
	.glow[data-result] .g-base {
		opacity: 0;
	}
	.glow.fade {
		opacity: 0;
		transition: opacity 1.5s ease;
	}
	@keyframes glow-breathe {
		from {
			opacity: 0.7;
			transform: translate(-50%, -50%) scale(0.96);
		}
		to {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1.04);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		:global(body[data-tool-state='wait']) .wait .glow:not(.fade) {
			animation: none;
		}
	}

	/* HERO */
	.hero {
		position: relative;
		z-index: 1;
		min-height: calc(100svh - 76px);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 34px;
		padding: 32px var(--gutter) 104px;
		text-align: center;
	}
	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		max-width: 780px;
	}
	.hero h1 {
		font-size: 68px;
		line-height: 1.03;
	}
	.hero .lead {
		margin: 0;
		font-size: 18px;
		line-height: 28px;
		color: var(--muted);
	}
	.mailwin {
		width: 100%;
		max-width: 760px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.92);
		overflow: hidden;
		text-align: left;
	}
	.mw-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 12px 22px;
		border-bottom: 1px solid var(--line);
		background: #fafafb;
	}
	.mw-title {
		font-size: 13px;
		font-weight: 600;
		color: #4a4b50;
	}
	.mw-tag {
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #6b6c72;
	}
	.mw-row {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 16px 22px;
		border-bottom: 1px solid var(--line);
	}
	.mw-label {
		width: 72px;
		flex: none;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6b6c72;
	}
	.address {
		flex: 1;
		min-width: 0;
		font-family: var(--font-mono);
		font-size: 21px;
		font-weight: 500;
		line-height: 1.3;
		min-height: 1.3em;
		overflow-wrap: anywhere;
	}
	.address :global(.nw) {
		white-space: nowrap;
	}
	.address-loading {
		color: var(--muted-2);
		font-family: var(--font-body);
		font-size: 16px;
	}
	.mw-copy {
		height: 40px;
		padding: 0 14px;
		font-size: 14px;
		flex: none;
	}
	.mw-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 14px 14px 22px;
	}
	.status-line {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 14px;
		color: var(--muted);
	}
	/* The mail program link is a phone thing: on desktop the address is copied. */
	.mw-mailto {
		display: none;
	}
	.trust {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		justify-content: center;
		gap: 10px 28px;
		flex-wrap: wrap;
		font-size: 14px;
		color: #4a4b50;
	}
	.trust li {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.chk {
		width: 18px;
		height: 18px;
		border-radius: 999px;
		background: var(--ok);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: none;
	}
	.scroll-hint {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		font-size: 13px;
		font-weight: 600;
		color: #4a4b50;
		text-decoration: none;
	}
	@keyframes nudge {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(4px);
		}
	}
	.nudge {
		animation: nudge 1.6s ease-in-out infinite;
	}

	/* WAIT */
	.wait {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
		align-items: center;
		justify-content: center;
		min-height: calc(100svh - 76px);
		padding: 32px var(--gutter) 64px;
	}
	.wait-visual {
		flex: 0 1 380px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 28px;
		text-align: center;
	}
	.wait-text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
	}
	.wait-title {
		font-size: clamp(26px, 3vw, 36px);
		line-height: 1.12;
		min-height: 2.24em;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		outline: none;
	}
	.wait-sub {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 15px;
		color: var(--muted);
		margin: 0;
	}
	.wait-addr {
		margin: 0;
		font-size: 13px;
		color: var(--muted-2);
		overflow-wrap: anywhere;
	}
	.linkbtn {
		border: none;
		background: none;
		padding: 8px 4px;
		font-size: 14px;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: rgba(17, 17, 19, 0.3);
		text-underline-offset: 3px;
		cursor: pointer;
		color: var(--ink);
	}
	.orb {
		position: relative;
		width: 200px;
		height: 200px;
		flex: none;
	}
	.prog {
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: conic-gradient(var(--ink) var(--p, 0%), rgba(17, 17, 19, 0.08) 0);
		transition: --p 0.5s ease;
	}
	.prog-mask {
		position: absolute;
		inset: 5px;
		border-radius: 999px;
		background: rgba(251, 251, 252, 0.92);
	}
	.ring2 {
		position: absolute;
		inset: 26px;
		border-radius: 999px;
		border: 1.5px dashed rgba(17, 17, 19, 0.35);
		animation: spinr 14s linear infinite;
	}
	.sat {
		position: absolute;
		inset: 0;
		animation: spin 3s linear infinite;
	}
	.sat span {
		position: absolute;
		top: -5px;
		left: 50%;
		margin-left: -7px;
		width: 14px;
		height: 14px;
		border-radius: 999px;
		background: var(--ink);
		box-shadow: 0 0 0 4px #fbfbfc;
	}
	.core {
		position: absolute;
		inset: 50px;
		border-radius: 999px;
		background: #fff;
		border: 1px solid var(--border);
		box-shadow: var(--shadow);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}
	.scan {
		position: absolute;
		left: 16%;
		right: 16%;
		height: 2px;
		border-radius: 999px;
		background: var(--ok);
		box-shadow: 0 0 14px 3px rgba(2, 202, 80, 0.35);
		top: 22%;
		will-change: transform;
		animation: scan 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
	}
	.pop {
		animation: pop 0.55s var(--ease-soft) both;
	}
	.ring2,
	.sat,
	.radar,
	.lamp,
	.fly {
		will-change: transform;
	}
	.orb.done {
		animation: bump 0.7s var(--ease-soft);
	}
	.burst {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.burst i {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 10px;
		height: 10px;
		margin: -5px 0 0 -5px;
		border-radius: 999px;
		background: var(--ink);
		animation: burst 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}
	.burst i:nth-child(3n + 2) {
		background: var(--ok);
	}
	.burst i:nth-child(3n) {
		width: 7px;
		height: 7px;
		margin: -3.5px 0 0 -3.5px;
		background: #9aa6b4;
	}
	.typing {
		display: inline-flex;
		gap: 5px;
	}
	.typing span {
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: var(--ink);
		animation: blink 1.2s infinite;
	}
	.typing span:nth-child(2) {
		animation-delay: 0.15s;
	}
	.typing span:nth-child(3) {
		animation-delay: 0.3s;
	}
	.steps-card {
		flex: 0 1 460px;
		padding: 26px 28px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}
	.step {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 11px 0;
	}
	.step + .step {
		border-top: 1px solid var(--line);
	}
	.st {
		width: 20px;
		height: 20px;
		border-radius: 999px;
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1.5px dashed #b9b9c0;
	}
	.st svg {
		opacity: 0;
	}
	.step[data-state='active'] .st {
		border: 2px solid rgba(17, 17, 19, 0.12);
		border-top-color: var(--ink);
		animation: spin 1.1s linear infinite;
	}
	.step[data-state='done'] .st {
		border: none;
		background: var(--ink);
		animation: pop 0.4s var(--ease-soft) both;
	}
	.step[data-state='done'] .st svg {
		opacity: 1;
	}
	.step-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		flex: 1;
		min-width: 0;
	}
	/* Long live details are cut with an ellipsis instead of widening the card. */
	.steps-card,
	.steps,
	.step {
		min-width: 0;
		max-width: 100%;
	}
	.step-label {
		font-size: 15px;
		font-weight: 500;
		color: var(--muted-2);
	}
	.step[data-state='active'] .step-label,
	.step[data-state='done'] .step-label {
		font-weight: 600;
		color: var(--ink);
	}
	.step-detail {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 12px;
		line-height: 18px;
		color: var(--muted);
	}
	.step[data-state='pending'] .step-detail {
		color: var(--faint);
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes spinr {
		to {
			transform: rotate(-360deg);
		}
	}
	@keyframes pop {
		0% {
			transform: scale(0.3);
			opacity: 0;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}
	@keyframes blink {
		0%,
		80%,
		100% {
			opacity: 0.25;
			transform: scale(0.75);
		}
		40% {
			opacity: 1;
			transform: scale(1);
		}
	}
	@keyframes scan {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(var(--scan-travel, 54px));
		}
	}
	@keyframes burst {
		from {
			transform: rotate(var(--a)) translateY(0) scale(1);
			opacity: 1;
		}
		to {
			transform: rotate(var(--a)) translateY(-128px) scale(0.3);
			opacity: 0;
		}
	}
	@keyframes bump {
		0% {
			transform: scale(1);
		}
		40% {
			transform: scale(1.035);
		}
		100% {
			transform: scale(1);
		}
	}
	@keyframes breathe {
		0%,
		100% {
			transform: scale(0.95);
		}
		50% {
			transform: scale(1);
		}
	}
	/* ---- wait: anticipation ---- */
	.panel-actions {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		justify-content: flex-end;
	}
	.btn[aria-disabled='true'] {
		opacity: 0.5;
		pointer-events: none;
	}
	.radar {
		position: absolute;
		inset: 5px;
		border-radius: 999px;
		background: conic-gradient(from 0deg, rgba(2, 202, 80, 0) 0deg, rgba(2, 202, 80, 0) 280deg, rgba(2, 202, 80, 0.22) 350deg, rgba(2, 202, 80, 0.5) 360deg);
		opacity: 0;
		transition: opacity 0.4s ease;
	}
	.orb.waiting .radar {
		opacity: 1;
		animation: spin 3.2s linear infinite;
	}
	.orb.waiting .sat {
		opacity: 0;
	}
	.sat {
		transition: opacity 0.3s ease;
	}
	.lamps {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.lamp {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 12px;
		height: 12px;
		margin: -6px 0 0 -6px;
		border-radius: 999px;
		background: #e4e4e8;
		box-shadow: 0 0 0 3px #fbfbfc;
		transform: rotate(var(--a)) translateY(-100px) rotate(calc(-1 * var(--a)));
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.orb:not(.waiting) .lamp {
		opacity: 1;
	}
	.lamp[data-status] {
		animation: lamp-on 0.7s var(--ease-soft) both;
	}
	.lamp[data-status='ok'] {
		background: var(--ok);
		box-shadow: 0 0 0 3px #fbfbfc, 0 0 16px 4px rgba(2, 202, 80, 0.45);
	}
	.lamp[data-status='warn'] {
		background: var(--warn);
		box-shadow: 0 0 0 3px #fbfbfc, 0 0 16px 4px rgba(255, 138, 0, 0.45);
	}
	.lamp[data-status='bad'] {
		background: var(--bad);
		box-shadow: 0 0 0 3px #fbfbfc, 0 0 16px 4px rgba(255, 64, 52, 0.45);
	}
	.lamp[data-status='skip'] {
		background: #b9b9c0;
	}
	.fly {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 34px;
		height: 34px;
		margin: -17px 0 0 -17px;
		z-index: 3;
		animation: fly-x 0.75s cubic-bezier(0.3, 0, 0.6, 1) both;
	}
	.fly-y {
		display: block;
		animation: fly-y 0.75s cubic-bezier(0.2, 0, 0.9, 0.4) both;
	}
	.fly svg {
		display: block;
		filter: drop-shadow(0 6px 10px rgba(17, 17, 19, 0.18));
	}
	.orb.arrived .core {
		animation: land 0.8s var(--ease-soft);
	}
	.nowrap {
		white-space: nowrap;
	}
	.wait-slot {
		display: grid;
		width: 100%;
		justify-items: center;
	}
	.wait-before,
	.wait-after {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		max-width: 100%;
		transition:
			opacity 0.45s ease,
			transform 0.6s var(--ease-soft),
			visibility 0s linear 0s;
	}
	.wait-slot[data-phase='after'] .wait-before,
	.wait-slot:not([data-phase='after']) .wait-after {
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.3s ease,
			transform 0.3s ease,
			visibility 0s linear 0.3s;
	}
	.wait-slot[data-phase='after'] .wait-before {
		transform: translateY(-8px);
	}
	.wait-slot:not([data-phase='after']) .wait-after {
		transform: translateY(10px);
	}
	.wait-mail.is-empty {
		display: none;
	}
	.wait-clock {
		margin: 0;
		font-size: 12px;
		color: var(--muted-2);
		min-height: 18px;
	}
	.wait-mail {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 12px 16px;
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: var(--shadow);
		text-align: left;
		max-width: 100%;
	}
	.wm-row[hidden] {
		display: none;
	}
	.wm-row {
		display: flex;
		align-items: baseline;
		gap: 10px;
		font-size: 14px;
		min-width: 0;
	}
	.wm-row .eyebrow {
		font-size: 11px;
		width: 56px;
		flex: none;
	}
	.wm-row > :last-child {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.wait-hint {
		margin: 0;
		max-width: 340px;
		font-size: 13px;
		line-height: 19px;
		color: var(--muted);
		min-height: 57px;
		transition: opacity 0.4s ease;
	}
	.wait-hint.fade {
		opacity: 0;
	}
	.st .ic-alert {
		display: none;
	}
	.step[data-state='done'] .st {
		color: #fff;
	}
	.step[data-status='ok'] .st {
		background: var(--ok);
		color: var(--ink);
	}
	.step[data-status='warn'] .st {
		background: var(--warn);
		color: var(--ink);
	}
	.step[data-status='bad'] .st {
		background: var(--bad);
		color: var(--ink);
	}
	.step[data-status='skip'] .st {
		background: #d4d4d8;
		color: var(--ink);
	}
	.step[data-status='warn'] .ic-ok,
	.step[data-status='bad'] .ic-ok {
		display: none;
	}
	.step[data-status='warn'] .ic-alert,
	.step[data-status='bad'] .ic-alert {
		display: block;
	}

	@keyframes lamp-on {
		0% {
			transform: rotate(var(--a)) translateY(-100px) rotate(calc(-1 * var(--a))) scale(0.4);
		}
		55% {
			transform: rotate(var(--a)) translateY(-100px) rotate(calc(-1 * var(--a))) scale(1.25);
		}
		100% {
			transform: rotate(var(--a)) translateY(-100px) rotate(calc(-1 * var(--a))) scale(1);
		}
	}
	@keyframes fly-x {
		from {
			transform: translateX(-170px) rotate(-24deg) scale(0.7);
		}
		to {
			transform: translateX(0) rotate(0) scale(1);
		}
	}
	@keyframes fly-y {
		from {
			transform: translateY(-190px);
			opacity: 0;
		}
		15% {
			opacity: 1;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}
	@keyframes land {
		0% {
			transform: scale(1);
			box-shadow: var(--shadow);
		}
		35% {
			transform: scale(0.96, 0.93);
		}
		65% {
			transform: scale(1.02);
			box-shadow: 0 0 0 10px rgba(2, 202, 80, 0.18), var(--shadow);
		}
		100% {
			transform: scale(1);
			box-shadow: 0 0 0 0 rgba(2, 202, 80, 0), var(--shadow);
		}
	}
	@property --p {
		syntax: '<percentage>';
		inherits: false;
		initial-value: 0%;
	}

	/* RESULT */
	.result {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}
	.mailhead {
		padding: 14px 22px;
		display: flex;
		align-items: center;
		gap: 12px 36px;
		flex-wrap: wrap;
	}
	.mh-item {
		display: flex;
		gap: 10px;
		align-items: baseline;
		min-width: 0;
		font-size: 14px;
	}
	.mh-item .eyebrow {
		font-size: 11px;
	}
	.mh-item > :last-child {
		overflow-wrap: anywhere;
	}
	.mh-spacer {
		flex: 1;
	}
	.mh-new {
		text-decoration: none;
	}
	.result-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: 40px;
		align-items: start;
	}
	.result-main {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.verdict {
		font-size: clamp(32px, 3.6vw, 44px);
		line-height: 1.08;
		outline: none;
	}
	.scorecard {
		padding: 28px;
		display: flex;
		gap: 36px;
		align-items: center;
	}
	.score-block {
		display: flex;
		flex-direction: column;
		gap: 8px;
		flex: none;
	}
	.score-block .eyebrow {
		font-size: 11px;
	}
	.score-num {
		font-size: 92px;
		line-height: 0.9;
		font-variant-numeric: tabular-nums;
	}
	.score-of {
		font-size: 20px;
		color: var(--faint);
		font-weight: 500;
	}
	.score-block .tag {
		align-self: flex-start;
	}
	.subs {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 18px;
		border-left: 1px solid var(--line);
		padding-left: 36px;
		min-width: 0;
	}
	.auth-warning {
		padding: 16px 20px;
		display: flex;
		gap: 14px;
		align-items: center;
		font-size: 14px;
		color: #4a4b50;
	}
	.auth-warning .tag {
		font-family: var(--font-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		font-size: 11px;
		flex: none;
	}
	.plan-head {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-top: 4px;
	}
	.plan-title {
		font-size: 28px;
	}
	.plan {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.passed {
		padding: 8px 20px 6px;
	}
	.passed-head {
		padding: 12px 4px;
		font-size: 14px;
		font-weight: 600;
	}
	.passed-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.result-side {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding-top: 6px;
		position: sticky;
		top: 92px;
	}
	.side-card {
		padding: 22px 24px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.side-text {
		margin: 0;
		font-size: 16px;
		line-height: 25px;
		color: var(--text);
	}
	.side-note {
		font-size: 13px;
		color: var(--muted-2);
	}
	.retest {
		width: 100%;
	}
	.tech summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		font-size: 14px;
		font-weight: 600;
		min-height: 24px;
	}
	.tech summary::-webkit-details-marker {
		display: none;
	}
	.tech-hint {
		font-size: 12px;
		color: var(--muted-2);
		font-weight: 500;
	}
	.tech-body {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding-top: 6px;
	}
	.setup {
		margin: 0;
		font-size: 13px;
		color: var(--muted-2);
		text-align: center;
	}
	.setup a {
		font-weight: 600;
	}

	/* GUIDE */
	.back {
		align-self: flex-start;
		text-decoration: none;
		margin-bottom: 8px;
	}
	.guide {
		display: flex;
		flex-direction: column;
	}
	.guide-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		gap: 48px;
		align-items: start;
	}
	.guide-intro {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.guide-title {
		font-size: clamp(30px, 3.4vw, 42px);
		outline: none;
	}
	.guide-pick {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.guide-card {
		padding: 30px;
		display: flex;
		flex-direction: column;
		gap: 22px;
	}
	.guide-steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.guide-note {
		margin: 0;
		font-size: 14px;
		color: var(--muted);
	}
	.guide-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	/* MESSAGE */
	.msg-card {
		max-width: 640px;
		margin: 24px auto 0;
		padding: 40px;
		display: flex;
		flex-direction: column;
		gap: 18px;
		align-items: flex-start;
	}
	.msg-title {
		font-size: clamp(28px, 3.4vw, 40px);
		outline: none;
	}

	@media (max-width: 960px) {
		.result-grid,
		.guide-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 28px;
		}
		.result-side {
			position: static;
		}
	}
	@media (max-width: 820px) {
		.hero {
			min-height: calc(100svh - 76px);
			padding: 32px var(--gutter) 96px;
			gap: 24px;
		}
		.hero h1 {
			font-size: 40px;
		}
		.glow {
			width: 420px;
			height: 220px;
		}
		.hero .lead {
			font-size: 16px;
			line-height: 25px;
		}
		.mw-row {
			flex-wrap: wrap;
			gap: 8px 12px;
			padding: 14px 16px;
		}
		.mw-head {
			padding: 10px 16px;
		}
		.mw-label {
			width: 56px;
		}
		/* Always two lines (break after @), reserved before the address loads: CLS 0. */
		.address {
			font-size: 16px;
			min-height: 2.6em;
		}
		.address :global(.nw) {
			display: block;
		}
		.address :global(wbr) {
			display: none;
		}
		.mw-copy {
			flex-basis: 100%;
