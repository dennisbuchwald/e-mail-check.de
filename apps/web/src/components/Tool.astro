---
// The mail test: hero/start → check animation → result → guide. Logic in src/scripts/tool.ts.
// mode "result" renders /ergebnis/<id>.
import { STEP_LABELS, STEPS } from '@emc/shared';
import { PROVIDERS, SITE } from '../data/site';
import Aura from './Aura.astro';

interface Props {
	mode?: 'test' | 'result';
	title?: string;
	intro?: string;
}
const { mode = 'test', title = 'Kommt deine Mail an?', intro = '' } = Astro.props;
const details: Record<string, string> = {
	received: 'Warte auf den Eingang deiner Mail …',
	spf: 'Suche den SPF-Eintrag deiner Domain …',
	dkim: 'Prüfe die DKIM-Unterschrift …',
	dmarc: 'Lese deine DMARC-Regel …',
	reputation: 'Frage Sperrlisten und rDNS ab …',
	content: 'Analysiere Betreff, Links und Inhalt …',
};
const copyIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>';
---

<section class="tool" id="tool" data-mode={mode} data-setup-url={SITE.setupUrl} aria-live="polite">
	<Aura variant="hero" grain class="tool-aura" />

	<!-- START -->
	<div class="screen hero" data-screen="start" hidden={mode === 'result'}>
		<div class="hero-copy">
			<h1>{title}</h1>
			{intro && <p class="lead">{intro}</p>}
		</div>
		<div class="mw-wrap">
		<div class="card mailwin">
			<div class="mw-head"><span class="mw-title">Neue Nachricht</span><span class="mono mw-tag">Testmail</span></div>
			<div class="mw-row">
				<span class="mw-label">An</span>
				<span class="address" data-address aria-live="off"><span class="address-loading">Adresse wird erstellt …</span></span>
				<button type="button" class="btn btn-line mw-copy copy-address" data-action="copy" disabled><span>Kopieren</span></button>
			</div>
			<div class="mw-foot">
				<span class="status-line"><span class="live"></span><span data-start-hint>Wir warten auf deine Mail.</span></span>
				<span class="panel-actions">
					<a class="btn btn-line mw-mailto" data-mailto href="#" aria-disabled="true"><span>Mail-Programm öffnen</span></a>
					<button type="button" class="btn btn-ink" data-action="sent" disabled
						>Mail ist raus<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button
					>
				</span>
			</div>
		</div>
		</div>
		<ul class="trust" aria-label="Datenschutz">
			<li><span class="chk" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg></span>Server in Deutschland</li>
			<li><span class="chk" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg></span>Testmail sofort gelöscht</li>
			<li><span class="chk" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"></path></svg></span>Keine Cookies, kein Konto</li>
		</ul>
		<a class="scroll-hint" href="#was-wir-pruefen"
			>Was wir prüfen<svg class="nudge" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></a
		>
	</div>

	<!-- WAIT / CHECK -->
	<div class="screen wait" data-screen="wait" hidden>
		<div class="wait-visual">
			<div class="orb" data-orb>
				<div class="prog" data-prog></div>
				<div class="prog-mask"></div>
				<div class="radar" aria-hidden="true"></div>
				<div class="ring2"></div>
				<div class="sat" data-sat><span></span></div>
				<div class="lamps" aria-hidden="true">{STEPS.slice(1).map((id, i) => <span class="lamp" data-lamp={id} style={`--a: ${i * 72}deg`} />)}</div>
				<div class="fly" data-fly aria-hidden="true" hidden
					><span class="fly-y"
						><svg width="34" height="34" viewBox="0 0 24 24" fill="#fff" stroke="#111113" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span
					></div
				>
				<div class="burst" data-burst hidden>{Array.from({ length: 12 }, (_, i) => <i style={`--a: ${i * 30}deg`} />)}</div>
				<div class="core">
					<div class="scan" data-scan hidden></div>
					<svg class="env" data-env-wait width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
						><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg
					>
					<svg class="env pop" data-env-got hidden width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#111113" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
						><path d="M21 12V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h8"></path><path d="M3 7l9 6 9-6"></path><path d="M16 19l2 2 4-4"></path></svg
					>
				</div>
			</div>
			<div class="wait-text">
				<h2 class="wait-title" data-wait-title tabindex="-1">Wir warten auf deine Mail</h2>
				<p class="wait-sub"><span class="typing" aria-hidden="true"><span></span><span></span><span></span></span><span data-wait-sub>Die Seite aktualisiert sich von selbst</span></p>
				<div class="wait-slot">
					<div class="wait-before" data-wait-before>
						<p class="wait-clock mono" data-wait-clock></p>
						<p class="wait-addr">An <span class="mono" data-address-small></span> <button type="button" class="linkbtn" data-action="copy">kopieren</button><br /><a class="linkbtn nowrap" data-mailto href="#">Mail-Programm öffnen</a></p>
						<p class="wait-hint" data-wait-hint aria-live="off"></p>
					</div>
					<div class="wait-after" data-wait-after>
						<div class="wait-mail" data-wait-mail>
							<span class="wm-row"><span class="eyebrow">Von</span><span class="mono" data-wm-from></span></span>
							<span class="wm-row" data-wm-subject-row><span class="eyebrow">Betreff</span><span data-wm-subject></span></span>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="card steps-card">
			<span class="eyebrow">Prüfung</span>
			<ol class="steps" data-steps>
				{
					STEPS.map((id) => (
						<li class="step" data-step={id} data-state="pending">
							<span class="st" aria-hidden="true">
								<svg class="ic-ok" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M5 12l4 4 10-10" />
								</svg>
								<svg class="ic-alert" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round">
									<path d="M12 5v9M12 19h.01" />
								</svg>
							</span>
							<span class="step-text">
								<span class="step-label">{STEP_LABELS[id]}</span>
								<span class="step-detail mono">{details[id]}</span>
							</span>
						</li>
					))
				}
			</ol>
		</div>
	</div>

	<!-- RESULT (packages/shared/src/result-view.ts). On /ergebnis/<id> Caddy fills it server-side, see infra/caddy/site.caddy. -->
	<div class="screen result wrap" data-screen="result" hidden={mode !== 'result'}>
		<div data-result-view>{mode === 'result' && <Fragment set:html={'<!--rv--><!--emc{httpInclude (printf "/api/results/%s/view" (placeholder "http.regexp.result.1"))}emc--><!--/rv-->'} />}</div>
	</div>

	<!-- GUIDE -->
	<div class="screen guide wrap" data-screen="guide" hidden>
		<button type="button" class="linkbtn back" data-action="back">‹ Zurück zum Ergebnis</button>
		<div class="guide-grid">
			<div class="guide-intro">
				<span class="eyebrow">Anleitung</span>
				<h2 class="guide-title" data-guide-title tabindex="-1">Schutzregel einrichten</h2>
				<p class="lead" data-guide-lead></p>
				<div class="guide-pick">
					<div class="eyebrow" id="provider-label">Wo liegt deine Domain?</div>
					<div class="chips" role="group" aria-labelledby="provider-label" data-providers>
						{PROVIDERS.map((p) => <button type="button" class="chip" data-provider={p.slug} aria-pressed="false">{p.name}</button>)}
						<button type="button" class="chip" data-provider="andere" aria-pressed="false">Anderer Anbieter</button>
					</div>
				</div>
			</div>
			<div class="card guide-card">
				<ol class="guide-steps" data-guide-steps></ol>
				<p class="guide-note">Neue Einträge brauchen manchmal ein paar Minuten, bis sie überall sichtbar sind.</p>
				<div class="guide-actions">
					<button type="button" class="btn btn-ink" data-action="retest">Erneut testen</button>
					<a class="btn btn-line" data-guide-link href="/anleitung">Ausführliche Anleitung</a>
				</div>
			</div>
		</div>
	</div>

	<!-- MESSAGE (expired, error, not found) -->
	<div class="screen msg wrap" data-screen="msg" hidden>
		<div class="card msg-card">
			<h1 class="msg-title" data-msg-title tabindex="-1">Diese Adresse ist abgelaufen</h1>
			<p class="lead" data-msg-text>Testadressen gelten 60 Minuten. Hol dir einfach eine neue.</p>
			<button type="button" class="btn btn-ink" data-action="reset">Neue Testadresse</button>
		</div>
	</div>
	<div class="sr-only" data-announce aria-live="assertive"></div>
</section>

<script>
	import { initTool } from '../scripts/tool';
	initTool();
</script>

<style>
	.tool {
		position: relative;
		background: #fff;
		/* clip, not hidden: the hero aura reaches up behind the status bar. */
		overflow-x: clip;
	}
	:global(body[data-tool-state='result']) .tool,
	:global(body[data-tool-state='guide']) .tool,
	:global(body[data-tool-state='msg']) .tool {
		background: var(--bg-soft);
		padding: 40px 0 72px;
	}
	.screen[hidden] {
		display: none !important;
	}

	/* Hero aura: runs up behind the transparent status bar and out into white at the bottom.
	   While checking it breathes; for result, guide and messages it goes away. */
	:global(.tool-aura) {
		top: -76px !important;
	}
	:global(body:is([data-tool-state='result'], [data-tool-state='guide'], [data-tool-state='msg'])) :global(.tool-aura) {
		display: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		:global(body[data-tool-state='wait']) :global(.tool-aura .aura-in) {
			animation: aura-breathe 2.4s ease-in-out infinite alternate;
		}
	}
	@keyframes aura-breathe {
		from {
			transform: scale(0.96);
		}
		to {
			transform: scale(1.04);
		}
	}
	.mw-wrap {
		width: 100%;
		max-width: 760px;
	}
	.wait > * {
		position: relative;
		z-index: 1;
	}


	/* HERO */
	.hero {
		position: relative;
		z-index: 1;
		min-height: calc(100svh - 76px);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 34px;
		padding: 32px var(--gutter) 104px;
		text-align: center;
	}
	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		max-width: 780px;
	}
	.hero h1 {
		font-size: 68px;
		line-height: 1.03;
	}
	.hero .lead {
		margin: 0;
		font-size: 18px;
		line-height: 28px;
		color: var(--muted-aura);
	}
	.mailwin {
		width: 100%;
		max-width: 760px;
		border-radius: 18px;
		/* Frosted glass over the aura. */
		background: rgba(255, 255, 255, 0.82);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		border-color: rgba(255, 255, 255, 0.9);
		box-shadow:
			0 1px 2px rgba(17, 17, 19, 0.05),
			0 24px 60px -12px rgba(40, 30, 90, 0.22);
		overflow: hidden;
		text-align: left;
	}
	.mw-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 12px 22px;
		border-bottom: 1px solid rgba(17, 17, 19, 0.06);
		background: rgba(250, 250, 251, 0.7);
	}
	.mw-title {
		font-size: 13px;
		font-weight: 600;
		color: #4a4b50;
	}
	.mw-tag {
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #6b6c72;
	}
	.mw-row {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 16px 22px;
		border-bottom: 1px solid rgba(17, 17, 19, 0.06);
	}
	.mw-label {
		width: 72px;
		flex: none;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6b6c72;
	}
	.address {
		flex: 1;
		min-width: 0;
		font-family: var(--font-mono);
		font-size: 21px;
		font-weight: 500;
		line-height: 1.3;
		min-height: 1.3em;
		overflow-wrap: anywhere;
	}
	.address :global(.nw) {
		white-space: nowrap;
	}
	.address-loading {
		color: var(--muted-2);
		font-family: var(--font-body);
		font-size: 16px;
	}
	.mw-copy {
		height: 40px;
		padding: 0 14px;
		font-size: 14px;
		flex: none;
	}
	.mw-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 14px 14px 22px;
	}
	.status-line {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 14px;
		color: var(--muted);
	}
	/* The mail program link is a phone thing: on desktop the address is copied. */
	.mw-mailto {
		display: none;
	}
	.trust {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		justify-content: center;
		gap: 10px 28px;
		flex-wrap: wrap;
		font-size: 14px;
		color: var(--muted-aura);
	}
	.trust li {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.chk {
		width: 18px;
		height: 18px;
		border-radius: 999px;
		background: var(--ok);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: none;
	}
	.scroll-hint {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		font-size: 13px;
		font-weight: 600;
		color: #4a4b50;
		text-decoration: none;
	}
	@keyframes nudge {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(4px);
		}
	}
	.nudge {
		animation: nudge 1.6s ease-in-out infinite;
	}

	/* WAIT */
	.wait {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
		align-items: center;
		justify-content: center;
		min-height: calc(100svh - 76px);
		padding: 32px var(--gutter) 64px;
	}
	.wait-visual {
		flex: 0 1 380px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 28px;
		text-align: center;
	}
	.wait-text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
	}
	.wait-title {
		font-size: clamp(26px, 3vw, 36px);
		line-height: 1.12;
		min-height: 2.24em;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		outline: none;
	}
	.wait-sub {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 15px;
		color: var(--muted);
		margin: 0;
	}
	.wait-addr {
		margin: 0;
		font-size: 13px;
		color: var(--muted-2);
		overflow-wrap: anywhere;
	}
	.linkbtn {
		border: none;
		background: none;
		padding: 8px 4px;
		font-size: 14px;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: rgba(17, 17, 19, 0.3);
		text-underline-offset: 3px;
		cursor: pointer;
		color: var(--ink);
	}
	.orb {
		position: relative;
		width: 200px;
		height: 200px;
		flex: none;
	}
	.prog {
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: conic-gradient(var(--ink) var(--p, 0%), rgba(17, 17, 19, 0.08) 0);
		transition: --p 0.5s ease;
	}
	.prog-mask {
		position: absolute;
		inset: 5px;
		border-radius: 999px;
		background: rgba(251, 251, 252, 0.92);
	}
	.ring2 {
		position: absolute;
		inset: 26px;
		border-radius: 999px;
		border: 1.5px dashed rgba(17, 17, 19, 0.35);
		animation: spinr 14s linear infinite;
	}
	.sat {
		position: absolute;
		inset: 0;
		animation: spin 3s linear infinite;
	}
	.sat span {
		position: absolute;
		top: -5px;
		left: 50%;
		margin-left: -7px;
		width: 14px;
		height: 14px;
		border-radius: 999px;
		background: var(--ink);
		box-shadow: 0 0 0 4px #fbfbfc;
	}
	.core {
		position: absolute;
		inset: 50px;
		border-radius: 999px;
		background: #fff;
		border: 1px solid var(--border);
		box-shadow: var(--shadow);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}
	.scan {
		position: absolute;
		left: 16%;
		right: 16%;
		height: 2px;
		border-radius: 999px;
		background: var(--ok);
		box-shadow: 0 0 14px 3px rgba(2, 202, 80, 0.35);
		top: 22%;
		will-change: transform;
		animation: scan 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
	}
	.pop {
		animation: pop 0.55s var(--ease-soft) both;
	}
	.ring2,
	.sat,
	.radar,
	.lamp,
	.fly {
		will-change: transform;
	}
	.orb.done {
		animation: bump 0.7s var(--ease-soft);
	}
	.burst {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.burst i {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 10px;
		height: 10px;
		margin: -5px 0 0 -5px;
		border-radius: 999px;
		background: var(--ink);
		animation: burst 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}
	.burst i:nth-child(3n + 2) {
		background: var(--ok);
	}
	.burst i:nth-child(3n) {
		width: 7px;
		height: 7px;
		margin: -3.5px 0 0 -3.5px;
		background: #9aa6b4;
	}
	.typing {
		display: inline-flex;
		gap: 5px;
	}
	.typing span {
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: var(--ink);
		animation: blink 1.2s infinite;
	}
	.typing span:nth-child(2) {
		animation-delay: 0.15s;
	}
	.typing span:nth-child(3) {
		animation-delay: 0.3s;
	}
	.steps-card {
		flex: 0 1 460px;
		padding: 26px 28px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}
	.step {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 11px 0;
	}
	.step + .step {
		border-top: 1px solid var(--line);
	}
	.st {
		width: 20px;
		height: 20px;
		border-radius: 999px;
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1.5px dashed #b9b9c0;
	}
	.st svg {
		opacity: 0;
	}
	.step[data-state='active'] .st {
		border: 2px solid rgba(17, 17, 19, 0.12);
		border-top-color: var(--ink);
		animation: spin 1.1s linear infinite;
	}
