---
// "Was bedeutet die Zahl?" (design/redesign/start-final-sektionen). Plain, crawlable HTML.
// "Was wir prüfen" is now MailRoute.astro (the six stations of the result page).
import { BANDS } from '@emc/shared';

const bands = [
	{ key: 'risk', color: 'var(--bad)', flex: 50 },
	{ key: 'endangered', color: 'var(--warn)', flex: 20 },
	{ key: 'solid', color: 'var(--faint)', flex: 20 },
	{ key: 'good', color: 'var(--ok)', flex: 10 },
] as const;
const fmt = (n: number) => n.toLocaleString('de-DE');
---

<section class="section" aria-labelledby="zahl-title">
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">Dein Score</span>
			<h2 id="zahl-title">Was bedeutet die Zahl?</h2>
		</div>
		<div class="card scale">
			<div class="scale-bar" aria-hidden="true">
				{bands.map((b) => <span style={`flex:${b.flex};background:${b.color}`} />)}
			</div>
			<div class="mono scale-ticks" aria-hidden="true"><span>0</span><span>5</span><span>7</span><span>9</span><span>10</span></div>
			<dl class="scale-bands">
				{
					bands.map((b) => (
						<div class="scale-band">
							<dt>
								<span class="sdot" style={`background:${b.color}`} />
								{BANDS[b.key].label}
							</dt>
							<dd class="mono">
								{fmt(BANDS[b.key].from)} bis {fmt(BANDS[b.key].to)}
							</dd>
							<dd class="scale-text">{BANDS[b.key].text}</dd>
						</div>
					))
				}
			</dl>
			<div class="exception">
				<span class="tag is-warn">Ausnahme</span>
				<span>Schlägt SPF, DKIM oder DMARC fehl, warnen wir immer, egal wie hoch die Zahl ist. Das allein kann Mails in den Spam schicken.</span>
			</div>
		</div>
	</div>
</section>

<style>
	.scale {
		padding: 36px;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.scale-bar {
		display: flex;
		gap: 6px;
	}
	.scale-bar span {
		height: 10px;
		border-radius: 999px;
	}
	.scale-ticks {
		display: grid;
		grid-template-columns: 50fr 20fr 20fr 10fr 0fr;
		font-size: 12px;
		color: var(--muted-2);
		margin-top: -14px;
	}
	.scale-bands {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 28px;
	}
	.scale-band {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.scale-band dt {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 16px;
		font-weight: 600;
	}
	.sdot {
		width: 9px;
		height: 9px;
		border-radius: 999px;
	}
	.scale-band dd {
		margin: 0;
	}
	.scale-band .mono {
		font-size: 12px;
		color: var(--muted-2);
	}
	.scale-text {
		font-size: 14px;
		line-height: 21px;
		color: #4a4b50;
	}
	.exception {
		border-top: 1px solid var(--line);
		padding-top: 20px;
		display: flex;
		align-items: center;
		gap: 14px;
		font-size: 14px;
		color: #4a4b50;
	}
	.exception .tag {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		flex: none;
	}
	@media (max-width: 900px) {
		.scale-bands {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 560px) {
		.scale {
			padding: 22px;
		}
		.scale-bands {
			grid-template-columns: minmax(0, 1fr);
			gap: 18px;
		}
		.exception {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
