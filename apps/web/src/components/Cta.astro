---
// Link to the mail test. Every content page carries one (hub and spoke).
interface Props {
	title?: string;
	text?: string;
	href?: string;
	label?: string;
}
const {
	title = 'Prüf es mit einer echten Mail',
	text = 'Schick eine Testmail und sieh in 30 Sekunden, ob SPF, DKIM und DMARC passen. Kostenlos, ohne Konto.',
	href = '/',
	label = 'Jetzt Testmail schicken',
} = Astro.props;
---

<aside class="card cta">
	<div>
		<p class="h cta-title">{title}</p>
		<p class="cta-text">{text}</p>
	</div>
	<a class="btn btn-ink" href={href} data-track="CTA geklickt">{label}</a>
</aside>

<style>
	.cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 20px 32px;
		padding: 28px 32px;
		margin: 40px 0;
	}
	.cta > div {
		flex: 1 1 320px;
	}
	.cta-title {
		font-size: 24px;
		margin: 0 0 6px;
	}
	.cta-text {
		margin: 0;
		color: var(--muted);
		font-size: 16px;
	}
	@media (max-width: 820px) {
		.cta {
			padding: 20px;
		}
		.cta .btn {
			width: 100%;
		}
	}
</style>
