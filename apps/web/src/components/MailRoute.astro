---
import '../styles/mailroute.css';
// "Der Weg deiner Mail": one isometric scene (scripts/mailroute.ts) beside six text steps.
// Desktop: the scene sticks in the middle of the viewport while the steps scroll; step i centred = envelope at station i.
// Phones: the scene sticks small at the top. Reduced motion: scene in its end state (logo with check), steps as a list.
// All text is real HTML; the scene box has a fixed 8:5 ratio, so nothing shifts when the scene loads.
const steps = [
	{ nr: '01', tech: 'SPF', title: 'Absender', text: 'Darf dein Server überhaupt Mails für deine Domain verschicken? Das steht im SPF-Eintrag.', href: '/wissen/spf', more: 'SPF' },
	{ nr: '02', tech: 'DKIM', title: 'Unterschrift', text: 'Ist deine Mail digital unterschrieben und unterwegs unverändert geblieben?', href: '/wissen/dkim', more: 'DKIM' },
	{ nr: '03', tech: 'DMARC', title: 'Schutzregel', text: 'Was passiert mit gefälschten Mails, die so tun, als kämen sie von dir?', href: '/wissen/dmarc', more: 'DMARC' },
	{ nr: '04', tech: 'Sperrlisten & rDNS', title: 'Server-Ruf', text: 'Steht dein Server auf einer Sperrliste, und hat er einen sauberen Namen?', href: '/wissen/mails-landen-im-spam', more: 'Sperrlisten' },
	{ nr: '05', tech: 'TLS', title: 'Transport', text: 'Kam deine Mail verschlüsselt an, und über welche Server lief sie?', href: null, more: '' },
	{ nr: '06', tech: 'Spamfilter & Inhalt', title: 'Posteingang', text: 'Wie viele Spam-Punkte sammelt deine Mail, und was löst sie aus?', href: '/wissen/mails-landen-im-spam', more: 'Spamfiltern' },
];
---

<section class="section route-sec" id="was-wir-pruefen" aria-labelledby="weg-title" data-route-sec>
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">Der Weg deiner Mail</span>
			<h2 id="weg-title">Durch diese sechs Stationen läuft jede E-Mail.</h2>
		</div>
		<div class="route-story">
			<div class="route-stage">
				<div class="route-scene" data-mailroute data-label="Illustration: der Weg einer Mail vom Absender bis ins Postfach"></div>
			</div>
			<ol class="route-list" data-route-list>
				{
					steps.map((s, i) => (
						<li class="route-step" data-step={i}>
							<div class="route-step-in">
								<span class="mono route-nr">
									{s.nr} · {s.tech}
								</span>
								<h3 class="h route-title">{s.title}</h3>
								<p class="route-text">{s.text}</p>
								{s.href && (
									<a class="route-link" href={s.href}>
										Mehr zu {s.more} ›
									</a>
								)}
								{i === steps.length - 1 && (
									<div class="route-arrived">
										<p class="h route-arrived-title">Angekommen.</p>
										<a class="btn btn-ink" href="#tool" data-to-test>
											Jetzt deine Mail testen ↑
										</a>
									</div>
								)}
							</div>
						</li>
					))
				}
			</ol>
		</div>
		<div class="route-steps">
			<ol class="mono">
				<li><span>01</span> Adresse kopieren</li>
				<li><span>02</span> Ganz normal schicken</li>
				<li><span>03</span> Ergebnis in 30 s</li>
			</ol>
			<a class="btn btn-line" href="#tool" data-to-test>Jetzt testen ↑</a>
		</div>
	</div>
</section>

<script>
	import { initMailRoute } from '../scripts/mailroute-section';
	initMailRoute();
	// "Jetzt testen" scrolls up to the hero and focuses the copy button of the test address.
	for (const a of document.querySelectorAll('[data-to-test]')) {
		a.addEventListener('click', (e) => {
			e.preventDefault();
			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
			document.querySelector<HTMLElement>('.copy-address')?.focus({ preventScroll: true });
		});
	}
</script>

<style>
	.route-sec .wrap {
		container-type: inline-size;
	}
	.route-story {
		--gap: 56px;
		--sw: calc((100cqi - var(--gap)) * 0.62);
		--sh: calc(var(--sw) * 0.625);
		display: grid;
		grid-template-columns: 62fr 38fr;
		gap: var(--gap);
		margin-top: -8px;
	}
	/* The scene box sticks with its middle on the middle of the viewport, where the active step sits too. */
	.route-stage {
		position: sticky;
		top: calc(50svh - var(--sh) / 2);
		align-self: start;
	}
	.route-scene {
		width: 100%;
		aspect-ratio: 8 / 5;
	}
	.route-list {
		list-style: none;
		margin: 0;
		padding: 0 0 6vh;
	}
	.route-step {
		min-height: 70vh;
		display: flex;
		align-items: center;
	}
	.route-step-in {
		display: flex;
		flex-direction: column;
		gap: 8px;
		max-width: 420px;
		transition: opacity 0.2s ease;
	}
	/* Dimming only while the section is being read (class from scripts/mailroute-section.ts), so the page
	   never loads with grey text. */
	:global(.route-sec.is-steps) .route-step:not(.is-active) .route-step-in {
		opacity: 0.3;
	}
	.route-nr {
		font-size: 12px;
		letter-spacing: 0.08em;
		color: var(--muted-2);
	}
	.route-title {
		margin: 0;
		font-size: 30px;
	}
	.route-text {
		margin: 0;
		font-size: 17px;
		line-height: 26px;
		color: var(--muted);
	}
	.route-link {
		margin-top: 4px;
		font-size: 15px;
		font-weight: 600;
		color: var(--ink);
		align-self: flex-start;
		min-height: 32px;
		display: inline-flex;
		align-items: center;
	}
	.route-arrived {
		margin-top: 18px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
		transition:
			opacity 0.35s ease,
			transform 0.35s var(--bounce);
	}
	.route-arrived-title {
		margin: 0;
		font-size: 30px;
	}
	/* "Angekommen." waits for the finale while the section is being read; without JS or with reduced motion it simply shows. */
	:global(.route-sec.is-steps:not(.is-arrived)) .route-arrived {
		opacity: 0;
		transform: translateY(8px);
		visibility: hidden;
	}
	.route-steps {
		margin-top: 32px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 28px;
	}
	.route-steps ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 10px 28px;
		font-size: 13px;
		color: var(--ink);
	}
	.route-steps li span {
		color: var(--muted-2);
		margin-right: 6px;
	}
	@media (max-width: 1080px) {
		.route-story {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
			margin-top: 0;
		}
		.route-stage {
			top: 76px;
			z-index: 2;
			padding: 4px 0 10px;
			background: var(--bg);
		}
		.route-scene {
			width: min(100%, 64svh);
			max-height: 40svh;
			margin: 0 auto;
		}
		.route-step {
			min-height: 50svh;
		}
		.route-title,
		.route-arrived-title {
			font-size: 26px;
		}
	}
	@media (max-width: 640px) {
		.route-steps {
			flex-direction: column;
			align-items: stretch;
		}
		.route-steps .btn {
			width: 100%;
			justify-content: center;
		}
	}
	/* Reduced motion: no sticky scene, no dimming, the steps are a plain list. */
	@media (prefers-reduced-motion: reduce) {
		.route-stage {
			position: static;
		}
		.route-step {
			min-height: 0;
			padding: 16px 0;
		}
		.route-step-in,
		.route-arrived {
			transition: none;
		}
	}
</style>
