---
// "Der Weg deiner Mail": one isometric scene (scripts/mailroute.ts) beside six text steps.
// Desktop: the scene sticks on the left while the steps scroll; the envelope follows the scroll through the steps.
// Phones: the scene sticks small at the top. Reduced motion: scene in its end state, steps as a plain list.
// All text is real HTML; the scene box has a fixed 5:4 ratio, so nothing shifts when the scene loads.
const steps = [
	{ nr: '01', tech: 'SPF', title: 'Absender', text: 'Darf dein Server überhaupt Mails für deine Domain verschicken? Das steht im SPF-Eintrag.', href: '/wissen/spf', more: 'SPF' },
	{ nr: '02', tech: 'DKIM', title: 'Unterschrift', text: 'Ist deine Mail digital unterschrieben und unterwegs unverändert geblieben?', href: '/wissen/dkim', more: 'DKIM' },
	{ nr: '03', tech: 'DMARC', title: 'Schutzregel', text: 'Was passiert mit gefälschten Mails, die so tun, als kämen sie von dir?', href: '/wissen/dmarc', more: 'DMARC' },
	{ nr: '04', tech: 'Sperrlisten, rDNS', title: 'Server-Ruf', text: 'Steht dein Server auf einer Sperrliste, und hat er einen sauberen Namen?', href: '/wissen/mails-landen-im-spam', more: 'Sperrlisten' },
	{ nr: '05', tech: 'TLS', title: 'Transport', text: 'Kam deine Mail verschlüsselt an, und über welche Server lief sie?', href: null, more: '' },
	{ nr: '06', tech: 'Spamfilter, Inhalt', title: 'Posteingang', text: 'Wie viele Spam-Punkte sammelt deine Mail, und was löst sie aus?', href: '/wissen/mails-landen-im-spam', more: 'Spamfiltern' },
];
---

<section class="section route-sec" id="was-wir-pruefen" aria-labelledby="weg-title" data-route-sec>
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">Der Weg deiner Mail</span>
			<h2 id="weg-title">Sechs Stationen bis ins Postfach. Wir prüfen jede.</h2>
		</div>
		<div class="route-story">
			<div class="route-stage">
				<div class="route-scene" data-mailroute data-label="Illustration: der Weg einer Mail vom Absender bis ins Postfach"></div>
			</div>
			<ol class="route-list" data-route-list>
				{
					steps.map((s, i) => (
						<li class="route-step" data-step={i}>
							<div class="route-step-in">
								<span class="mono route-nr">
									{s.nr} · {s.tech}
								</span>
								<h3 class="h route-title">{s.title}</h3>
								<p class="route-text">{s.text}</p>
								{s.href && (
									<a class="route-link" href={s.href}>
										Mehr zu {s.more} ›
									</a>
								)}
							</div>
						</li>
					))
				}
			</ol>
		</div>
		<div class="route-steps">
			<ol class="mono">
				<li><span>01</span> Adresse kopieren</li>
				<li><span>02</span> Ganz normal schicken</li>
				<li><span>03</span> Ergebnis in 30 s</li>
			</ol>
			<a class="btn btn-line" href="#tool" data-to-test>Jetzt testen ↑</a>
		</div>
	</div>
</section>

<script>
	import { initMailRoute } from '../scripts/mailroute-section';
	initMailRoute();
	// "Jetzt testen" scrolls up to the hero and focuses the copy button of the test address.
	document.querySelector('[data-to-test]')?.addEventListener('click', (e) => {
		e.preventDefault();
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
		document.querySelector<HTMLElement>('.copy-address')?.focus({ preventScroll: true });
	});
</script>

<style>
	.route-sec {
		/* Colours of the scene (hairline custom properties): ink lines, light helper lines, green only for the check rings. */
		--hairline-plate: #ffffff;
		--hairline-hi: #111113;
		--hairline-edge: #111113;
		--hairline-mid: #6b6c70;
		--hairline-lo: #c9c9cf;
		--hairline-stroke: 0.9;
		--dim: #b4b5ba;
	}
	.route-sec :global([data-hairline='mailroute'] .hi) {
		stroke-width: 1.6;
	}
	.route-sec :global([data-hairline='mailroute'] .dot.ok) {
		fill: var(--ok);
	}
	.route-story {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
		gap: 48px;
	}
	.route-stage {
		position: sticky;
		top: 76px;
		height: calc(100svh - 76px);
		display: flex;
		align-items: center;
	}
	.route-scene {
		width: 100%;
		aspect-ratio: 5 / 4;
		max-height: calc(100svh - 76px - 32px);
		margin: 0 auto;
	}
	.route-list {
		list-style: none;
		margin: 0;
		/* lets the first and the last step reach the middle while the scene still sticks */
		padding: 20vh 0;
	}
	.route-step {
		min-height: 60vh;
		display: flex;
		align-items: center;
		color: var(--ink);
	}
	.route-step-in {
		display: flex;
		flex-direction: column;
		gap: 8px;
		max-width: 420px;
	}
	.route-nr {
		font-size: 12px;
		letter-spacing: 0.08em;
		color: var(--muted-2);
	}
	.route-title {
		margin: 0;
		font-size: 30px;
	}
	.route-text {
		margin: 0;
		font-size: 17px;
		line-height: 26px;
		color: var(--muted);
	}
	.route-link {
		margin-top: 4px;
		font-size: 15px;
		font-weight: 600;
		color: var(--ink);
		align-self: flex-start;
		min-height: 32px;
		display: inline-flex;
		align-items: center;
	}
	/* Inactive steps are dimmed only while the section scrolls: primarily by a CSS view timeline,
	   otherwise by scripts/mailroute-section.ts (class is-steps on the section, is-active on the step). */
	@property --dimk {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	@keyframes route-dim {
		0%,
		22%,
		78%,
		100% {
			--dimk: 1;
		}
		38%,
		62% {
			--dimk: 0;
		}
	}
	.route-step .route-nr {
		color: color-mix(in srgb, var(--dim) calc(var(--dimk) * 100%), var(--muted-2));
	}
	.route-step :is(.route-title, .route-link) {
		color: color-mix(in srgb, var(--dim) calc(var(--dimk) * 100%), var(--ink));
	}
	.route-step .route-text {
		color: color-mix(in srgb, var(--dim) calc(var(--dimk) * 100%), var(--muted));
	}
	@supports (animation-timeline: view()) {
		.route-sec:not(.is-static) .route-step {
			animation: route-dim linear none;
		}
		.route-sec:not(.is-static) li.route-step {
			animation-timeline: view(block var(--inset-top, 0px) 0px);
		}
	}
	:global(.route-sec.is-steps) .route-step:not(.is-active) {
		--dimk: 1;
	}
	.route-steps {
		margin-top: 32px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 28px;
	}
	.route-steps ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 10px 28px;
		font-size: 13px;
		color: var(--ink);
	}
	.route-steps li span {
		color: var(--muted-2);
		margin-right: 6px;
	}
	@media (max-width: 1080px) {
		.route-story {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}
		.route-sec {
			--inset-top: calc(76px + 40svh);
		}
		.route-stage {
			z-index: 2;
			height: auto;
			padding: 8px 0 12px;
			background: var(--bg);
		}
		.route-scene {
			width: min(100%, 50svh);
			max-height: 40svh;
		}
		.route-list {
			padding: 0 0 12vh;
		}
		.route-step {
			min-height: 50svh;
		}
		.route-title {
			font-size: 26px;
		}
	}
	@media (max-width: 640px) {
		.route-steps {
			flex-direction: column;
			align-items: stretch;
		}
		.route-steps .btn {
			width: 100%;
			justify-content: center;
		}
	}
	/* Reduced motion: no sticky scene, no dimming, the steps are a plain list. */
	@media (prefers-reduced-motion: reduce) {
		.route-stage {
			position: static;
			height: auto;
			align-items: flex-start;
		}
		.route-list {
			padding: 0;
		}
		.route-step,
		li.route-step {
			min-height: 0;
			padding: 16px 0;
			animation: none;
		}
	}
</style>
