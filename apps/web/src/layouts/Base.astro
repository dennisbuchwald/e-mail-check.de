---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Logo from '../components/Logo.astro';
import { FOOTER, NAV, SITE } from '../data/site';

interface Props {
	title: string;
	description: string;
	/** Path without trailing slash, e.g. "/spf-check". Defaults to current path. */
	path?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>[];
	/** Tool pages hide the header CTA while the test is at its start screen. */
	tool?: boolean;
}
const { title, description, path = Astro.url.pathname.replace(/\/$/, '') || '/', noindex = false, jsonLd = [], tool = false } = Astro.props;
const canonical = new URL(path, SITE.url).href.replace(/\/$/, path === '/' ? '/' : '');
const ogImage = new URL('/og.png', SITE.url).href;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href.split('/').slice(0, 2).join('/') + '/'));
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
		<link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#ffffff" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
	</head>
	<body data-tool-state={tool ? 'start' : undefined}>
		<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
		<header class="wrap site-header">
			<div class="card head-card">
				<a href="/" class="home" aria-label="e-mail-check.de, zur Startseite"><Logo /></a>
				<nav aria-label="Hauptnavigation" class="nav">
					{
						NAV.map((item) => (
							<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						))
					}
					{
						tool ? (
							<button type="button" class="btn btn-ink btn-sm head-cta" data-action="reset">
								Neuer Test
							</button>
						) : (
							<a href="/" class="btn btn-ink btn-sm head-cta">
								Mail testen
							</a>
						)
					}
				</nav>
			</div>
		</header>

		<main id="inhalt" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="foot-grid">
					{
						FOOTER.map((col) => (
							<nav aria-label={col.title}>
								<h2 class="foot-title">{col.title}</h2>
								<ul>
									{col.links.map((l) => (
										<li>
											<a href={l.href}>{l.label}</a>
										</li>
									))}
								</ul>
							</nav>
						))
					}
				</div>
				<div class="foot-bottom">
					<span>Ein Projekt von <a href={SITE.ownerUrl} style="font-weight:700">{SITE.owner}</a></span>
					<span>Server in Deutschland · Testmails sofort gelöscht · ohne Cookies</span>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	.site-header {
		padding-top: 24px;
	}
	.head-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px 16px;
		padding: 12px 14px 12px 22px;
	}
	.home {
		text-decoration: none;
		display: inline-flex;
		min-height: 44px;
		align-items: center;
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 4px 20px;
		flex-wrap: wrap;
		font-size: 14px;
		font-weight: 600;
	}
	.nav a:not(.btn) {
		text-decoration: none;
		padding: 10px 2px;
	}
	.nav a:not(.btn):hover,
	.nav a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 6px;
		text-decoration-thickness: 2px;
	}
	:global(body[data-tool-state='start']) .head-cta {
		display: none;
	}
	main {
		flex: 1;
		outline: none;
	}
	.site-footer {
		margin-top: 96px;
		border-top: 2px solid var(--divider);
		padding: 48px 0 32px;
		font-size: 14px;
	}
	.foot-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
		gap: 32px;
	}
	.foot-title {
		font-family: var(--font-body);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0;
		margin: 0 0 12px;
	}
	.foot-grid ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
	}
	.foot-grid a {
		color: var(--muted);
		text-decoration: none;
		display: inline-block;
		padding: 6px 0;
	}
	.foot-grid a:hover {
		color: var(--ink);
		text-decoration: underline;
	}
	.foot-bottom {
		margin-top: 40px;
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		color: var(--muted);
		font-size: 13px;
	}
	@media (max-width: 820px) {
		.site-header {
			padding-top: 16px;
		}
		.head-card {
			padding: 10px 12px 10px 16px;
		}
		.nav {
			gap: 0 14px;
			font-size: 13px;
		}
		.nav a:not(.btn) {
			display: none;
		}
	}
</style>
