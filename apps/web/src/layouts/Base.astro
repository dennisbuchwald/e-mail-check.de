---
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
// Own subsets: Fraunces only at 680 with opsz 24 to 72, Inter 400 to 700, Latin and German punctuation.
// Built from the fontsource files with fonttools, see src/fonts/README.md. 57 KB instead of 115 KB.
import frauncesUrl from '../fonts/fraunces-680-latin.woff2?url';
import interUrl from '../fonts/inter-400-700-latin.woff2?url';
import Wordmark from '../components/Wordmark.astro';
import { FOOTER, RATGEBER, SITE } from '../data/site';

interface Props {
	title: string;
	description: string;
	/** Path without trailing slash, e.g. "/spf-check". Defaults to current path. */
	path?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>[];
	/** Tool pages: body carries the tool state (start, wait, result …); "result" for /ergebnis/<id>, so the layout is right before JS. */
	tool?: boolean | 'result';
	/** Soft grey page background (result, sub pages). */
	soft?: boolean;
}
const { title, description, path = Astro.url.pathname.replace(/\/$/, '') || '/', noindex = false, jsonLd = [], tool = false, soft = false } = Astro.props;
// Umami is only loaded when PUBLIC_UMAMI_ID is set at build time (off locally).
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
const canonical = new URL(path, SITE.url).href.replace(/\/$/, path === '/' ? '/' : '');
const ogImage = new URL('/og.png', SITE.url).href;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
		<link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#ffffff" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		{umamiId && <script defer src="/stats/script.js" data-website-id={umamiId} data-host-url="/stats" data-do-not-track="true" />}
		{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
	</head>
	<body data-tool-state={tool === 'result' ? 'result' : tool ? 'start' : undefined} class:list={[{ soft }]}>
		<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
		<header class="statusbar" data-statusbar>
			<div class="wrap sb-inner">
			<a href="/" class="sb-home" aria-label="mail check, Startseite"><Wordmark id="sb" class="sb-wm" /></a>
			<span class="sb-pill mono"
				><span class="live" aria-hidden="true"></span><span class="sb-long">System bereit · Server DE<span data-checked> · Kostenlos · ohne Konto</span></span><span class="sb-short">Bereit</span></span
			>
			<div class="sb-menu" data-menu>
				<button type="button" class="sb-guide" aria-expanded="false" aria-controls="ratgeber-menu" data-menu-button
					>Ratgeber<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></button
				>
				<nav id="ratgeber-menu" class="sb-drop" aria-label="Ratgeber" hidden data-menu-panel>
					{
						RATGEBER.map((group) => (
							<div class="sb-group">
								<span class="sb-group-title">{group.title}</span>
								<ul>
									{group.links.map((l) => (
										<li>
											<a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
												{l.label}
											</a>
										</li>
									))}
								</ul>
							</div>
						))
					}
				</nav>
			</div>
			</div>
		</header>

		<main id="inhalt" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="foot-grid">
					<div class="foot-brand">
						<Wordmark id="foot" class="foot-wm" />
						<p>Der deutsche Mail-Tester für alle, die keine Mail-Techniker sind. Kostenlos, ohne Konto, Server in Deutschland.</p>
					</div>
					{
						FOOTER.map((col) => (
							<nav aria-label={col.title}>
								<h2 class="foot-title">{col.title}</h2>
								<ul>
									{col.links.map((l) => (
										<li>
											<a href={l.href}>{l.label}</a>
										</li>
									))}
								</ul>
							</nav>
						))
					}
				</div>
				<div class="foot-bottom">
					<span>Ein Projekt von <a href={SITE.ownerUrl}>{SITE.owner}</a> · <a href="https://github.com/dennisbuchwald/e-mail-check.de">Open Source</a></span>
					<span class="mono">Server in Deutschland · Testmails sofort gelöscht · ohne Cookies</span>
				</div>
			</div>
		</footer>
		<script>
			import '../scripts/statusbar';
		</script>
	</body>
</html>

<style>
	/* ---- status bar ---- */
	/* Background spans the full width, the content sits on the page's content width. */
	.statusbar {
		position: sticky;
		top: 0;
		z-index: 20;
	}
	.sb-inner {
		height: 76px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}
	.sb-home {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		line-height: 0;
		border-radius: 8px;
	}
	.sb-home :global(.wordmark) {
		height: 52px;
		width: auto;
		overflow: visible;
	}
	.sb-pill {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 32px;
		padding: 0 14px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.8);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #4a4b50;
		white-space: nowrap;
	}
	.sb-short {
		display: none;
	}
	.sb-menu {
		position: relative;
	}
	.sb-guide {
		display: flex;
		align-items: center;
		gap: 6px;
		min-height: 44px;
		padding: 0 4px;
		border: 0;
		background: none;
		font: 600 14px var(--font-body);
		color: var(--ink);
		cursor: pointer;
	}
	.sb-guide svg {
		transition: transform 0.2s ease;
	}
	.sb-guide[aria-expanded='true'] svg {
		transform: rotate(180deg);
	}
	.sb-drop {
		position: absolute;
		right: 0;
		top: calc(100% + 8px);
		width: min(560px, calc(100vw - 32px));
		padding: 20px;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 16px;
		box-shadow: var(--shadow-lg);
	}
	.sb-drop[hidden] {
		display: none;
	}
	.sb-group-title {
		display: block;
		margin-bottom: 6px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-2);
	}
	.sb-drop ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.sb-drop a {
		display: block;
		padding: 6px 0;
		font-size: 14px;
		color: var(--ink);
		text-decoration: none;
	}
	.sb-drop a:hover,
	.sb-drop a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* Animation A: the check badge pops into the logo on every page load. */
	.statusbar :global(.badge-load),
	.statusbar :global(.ko-load) {
		transform-box: fill-box;
		transform-origin: center;
		animation: wm-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.45s both;
	}
	.statusbar :global(.check-load) {
		stroke-dasharray: 1;
		animation: wm-draw 0.35s ease-out 0.85s both;
	}
	@keyframes wm-pop {
		0% {
			transform: scale(0);
		}
		70% {
			transform: scale(1.15);
		}
		100% {
			transform: scale(1);
		}
	}
	@keyframes wm-draw {
		from {
			stroke-dashoffset: 1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	/* Animation B: on scroll the text leaves and the mark grows inside the wordmark area. */
	.statusbar :global(.mark-grow) {
		transform-origin: 1750.8px -482px;
	}
	@keyframes wm-text-out {
		to {
			opacity: 0;
			transform: translateX(-60px);
		}
	}
	@keyframes wm-grow {
		to {
			transform: translate(-1750.8px, -76px) scale(3);
		}
	}
	@keyframes sb-bg {
		to {
			background-color: rgba(255, 255, 255, 0.86);
			box-shadow: 0 1px 0 #ededf0;
		}
	}
	/* The timeline sits in a second selector on purpose: the CSS minifier would otherwise fold
	   animation-timeline into the animation shorthand, where browsers reject it. */
	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.statusbar :global(.wm-text) {
				animation: wm-text-out linear both;
			}
			.statusbar :global(g.wm-text) {
				animation-timeline: scroll();
				animation-range: 0px 90px;
			}
			.statusbar :global(.mark-grow) {
				animation: wm-grow cubic-bezier(0.55, 0, 0.25, 1) both;
			}
			.statusbar :global(g.mark-grow) {
				animation-timeline: scroll();
				animation-range: 20px 160px;
			}
			.statusbar {
				animation: sb-bg linear both;
			}
			:is(.statusbar) {
				animation-timeline: scroll();
				animation-range: 60px 160px;
			}
		}
	}
	/* Fallback (no scroll timelines): same end state via class + transition. */
	.statusbar :global(.wm-text),
	.statusbar :global(.mark-grow) {
		transition:
			opacity 0.3s ease,
			transform 0.3s cubic-bezier(0.55, 0, 0.25, 1);
	}
	.statusbar {
		transition:
			background-color 0.3s ease,
			box-shadow 0.3s ease;
	}
	.statusbar.is-compact {
		background-color: rgba(255, 255, 255, 0.86);
		box-shadow: 0 1px 0 #ededf0;
	}
	.statusbar.is-compact :global(.wm-text) {
		opacity: 0;
		transform: translateX(-60px);
	}
	.statusbar.is-compact :global(.mark-grow) {
		transform: translate(-1750.8px, -76px) scale(3);
	}
	@media (prefers-reduced-motion: reduce) {
		.statusbar :global(.badge-load),
		.statusbar :global(.ko-load),
		.statusbar :global(.check-load) {
			animation: none;
		}
		.statusbar,
		.statusbar :global(.wm-text),
		.statusbar :global(.mark-grow) {
			transition: none;
		}
	}
	:global(body.soft) {
		background: var(--bg-soft);
	}
	main {
		flex: 1;
		outline: none;
	}
	.site-footer {
		border-top: 1px solid var(--line);
		padding: 64px 0 32px;
		font-size: 14px;
		background: var(--bg);
	}
	.foot-grid {
		display: grid;
		grid-template-columns: 1.4fr repeat(4, 1fr);
		gap: 32px;
	}
	.foot-brand p {
		margin: 14px 0 0;
		color: var(--muted);
		max-width: 26em;
		line-height: 1.6;
	}
	.foot-title {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-2);
		margin: 0 0 12px;
	}
	.foot-grid ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
	}
	.foot-grid a {
		color: var(--text);
		text-decoration: none;
		display: inline-block;
		padding: 5px 0;
	}
	.foot-grid a:hover {
		text-decoration: underline;
	}
	.foot-bottom {
		margin-top: 48px;
		padding-top: 20px;
		border-top: 1px solid var(--line);
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		color: var(--muted-2);
		font-size: 13px;
	}
	.foot-bottom .mono {
		font-size: 12px;
	}
	@media (max-width: 960px) {
		.foot-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.foot-brand {
			grid-column: 1 / -1;
		}
	}
	.foot-brand :global(.foot-wm) {
		display: block;
		height: 44px;
		width: auto;
	}
	@media (max-width: 820px) {
		.sb-home :global(.wordmark) {
			height: 40px;
		}
		.sb-long {
			display: none;
		}
		.sb-short {
			display: inline;
		}
		.sb-drop {
			position: fixed;
			left: 16px;
			right: 16px;
			top: 76px;
			width: auto;
			grid-template-columns: minmax(0, 1fr);
			gap: 14px;
			max-height: calc(100svh - 96px);
			overflow: auto;
		}
	}
</style>
