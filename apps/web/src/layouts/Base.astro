---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Logo from '../components/Logo.astro';
import { FOOTER, NAV, SITE } from '../data/site';

interface Props {
	title: string;
	description: string;
	/** Path without trailing slash, e.g. "/spf-check". Defaults to current path. */
	path?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>[];
	/** Tool pages hide the header CTA while the test is at its start screen. */
	tool?: boolean;
	/** Transparent header over the hero aura (start page). */
	overlay?: boolean;
	/** Soft grey page background (result, sub pages). */
	soft?: boolean;
}
const { title, description, path = Astro.url.pathname.replace(/\/$/, '') || '/', noindex = false, jsonLd = [], tool = false, overlay = false, soft = false } = Astro.props;
// Umami is only loaded when PUBLIC_UMAMI_ID is set at build time (off locally).
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
const canonical = new URL(path, SITE.url).href.replace(/\/$/, path === '/' ? '/' : '');
const ogImage = new URL('/og.png', SITE.url).href;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href.split('/').slice(0, 2).join('/') + '/'));
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
		<link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#ffffff" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		{umamiId && <script defer src="/stats/script.js" data-website-id={umamiId} data-host-url="/stats" data-do-not-track="true" />}
		{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
	</head>
	<body data-tool-state={tool ? 'start' : undefined} class:list={[{ soft }]}>
		<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
		<header class:list={['site-header', { overlay }]}>
			<div class="wrap head-inner">
				<a href="/" class="home" aria-label="e-mail-check.de, zur Startseite"><Logo /></a>
				<nav aria-label="Hauptnavigation" class="nav">
					{
						NAV.map((item) => (
							<a href={item.href} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						))
					}
					{
						tool ? (
							<button type="button" class="btn btn-ink btn-sm head-cta" data-action="reset">
								Neuer Test
							</button>
						) : (
							<a href="/" class="btn btn-ink btn-sm head-cta">
								Mail testen
							</a>
						)
					}
				</nav>
			</div>
		</header>

		<main id="inhalt" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="foot-grid">
					<div class="foot-brand">
						<Logo size={26} />
						<p>Der deutsche Mail-Tester für alle, die keine Mail-Techniker sind. Kostenlos, ohne Konto, Server in Deutschland.</p>
					</div>
					{
						FOOTER.map((col) => (
							<nav aria-label={col.title}>
								<h2 class="foot-title">{col.title}</h2>
								<ul>
									{col.links.map((l) => (
										<li>
											<a href={l.href}>{l.label}</a>
										</li>
									))}
								</ul>
							</nav>
						))
					}
				</div>
				<div class="foot-bottom">
					<span>Ein Projekt von <a href={SITE.ownerUrl}>{SITE.owner}</a> · <a href="https://github.com/dennisbuchwald/e-mail-check.de">Open Source</a></span>
					<span class="mono">Server in Deutschland · Testmails sofort gelöscht · ohne Cookies</span>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background-color: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}
	/* Home: glass bar over the full-height hero, stays on top while scrolling. */
	.site-header.overlay {
		position: fixed;
		left: 0;
		right: 0;
		border-bottom-color: rgba(17, 17, 19, 0.06);
	}
	.head-inner {
		height: 72px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}
	.home {
		text-decoration: none;
		display: inline-flex;
		min-height: 44px;
		align-items: center;
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 28px;
	}
	.nav-link {
		font-size: 14px;
		font-weight: 500;
		color: #4a4b50;
		text-decoration: none;
		padding: 10px 0;
	}
	.nav-link:hover,
	.nav-link[aria-current='page'] {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 6px;
	}
	:global(body[data-tool-state='start']) .head-cta {
		display: none;
	}
	:global(body.soft) {
		background: var(--bg-soft);
	}
	main {
		flex: 1;
		outline: none;
	}
	.site-footer {
		border-top: 1px solid var(--line);
		padding: 64px 0 32px;
		font-size: 14px;
		background: var(--bg);
	}
	.foot-grid {
		display: grid;
		grid-template-columns: 1.4fr repeat(4, 1fr);
		gap: 32px;
	}
	.foot-brand p {
		margin: 14px 0 0;
		color: var(--muted);
		max-width: 26em;
		line-height: 1.6;
	}
	.foot-title {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-2);
		margin: 0 0 12px;
	}
	.foot-grid ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
	}
	.foot-grid a {
		color: var(--text);
		text-decoration: none;
		display: inline-block;
		padding: 5px 0;
	}
	.foot-grid a:hover {
		text-decoration: underline;
	}
	.foot-bottom {
		margin-top: 48px;
		padding-top: 20px;
		border-top: 1px solid var(--line);
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		color: var(--muted-2);
		font-size: 13px;
	}
	.foot-bottom .mono {
		font-size: 12px;
	}
	@media (max-width: 960px) {
		.foot-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.foot-brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 820px) {
		.nav {
			gap: 0;
		}
		.nav-link {
			display: none;
		}
		.head-inner {
			height: 64px;
		}
	}
</style>
