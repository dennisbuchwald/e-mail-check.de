---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import HomeSections from '../components/HomeSections.astro';
import MailRoute from '../components/MailRoute.astro';
import Faq from '../components/Faq.astro';
import Prose from '../components/Prose.astro';
import { appSchema, faqSchema, websiteSchema } from '../data/schema';

const page = await getEntry('seiten', 'index');
if (!page) throw new Error('content/seiten/index.md missing');
const { Content } = await render(page);
---

<Base title={page.data.seoTitel} description={page.data.beschreibung} path="/" tool jsonLd={[websiteSchema, appSchema, ...faqSchema(page.data.faq)]}>
	<Tool title={page.data.titel} intro={page.data.intro} />
	<div class="home-below">
		<MailRoute />
		<HomeSections />
		<section class="section section-soft">
			<div class="wrap narrow-wrap"><Faq items={page.data.faq} /></div>
		</section>
		<section class="section">
			<div class="wrap content-grid">
				<Prose class="narrow"><Content /></Prose>
			</div>
		</section>
	</div>
</Base>

<style>
	.content-grid {
		display: flex;
		justify-content: center;
	}
	.narrow-wrap {
		max-width: 828px;
	}
	/* The SEO content stays crawlable for the start page. While waiting and for a result (also right after
	   the test, without a reload) the page is the result alone, exactly like the shared link. */
	:global(body:is([data-tool-state='wait'], [data-tool-state='result'], [data-tool-state='guide'])) .home-below {
		display: none;
	}
</style>
