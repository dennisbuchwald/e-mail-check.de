# Copy to .env on the server. Never commit .env.
SITE_DOMAIN=e-mail-check.de
MX_HOSTNAME=mx.e-mail-check.de
TEST_DOMAIN=test.e-mail-check.de
# Preview protection until go-live (basic auth). Hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<passwort>'
# In .env every $ in the hash must be written as $$.
PREVIEW_USER=vorschau
PREVIEW_HASH=

# Optional statistics (docker compose --profile stats ...)
PUBLIC_UMAMI_ID=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
